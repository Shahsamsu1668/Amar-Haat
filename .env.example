# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DAM price sync (POST /api/market/sync-prices): cron ping secret + optional source URL
MARKET_SYNC_SECRET=
# DAM_PRICE_URL=

# Firebase Web Client (Phone OTP Auth + Invisible reCAPTCHA)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK (Backend cryptographic ID token verification)
# Option 1 (Recommended on Render): single-line JSON of service account credentials
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option 2: individual service account environment variables
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Free Email OTP (replaces paid SMS) ───────────────────────────────────────
# Enable "Google" provider in Firebase Console > Authentication > Sign-in method
# and add your domain under Authentication > Settings > Authorized domains.
# Option 1 (Recommended on Render): Brevo HTTP API (free tier, <1s HTTPS delivery)
BREVO_API_KEY=
# BREVO_FROM="Amar Haat <your@gmail.com>"
# Option 2: Resend HTTP API (free tier)
RESEND_API_KEY=
# RESEND_FROM="Amar Haat <onboarding@resend.dev>"
# Option 3: SMTP via Nodemailer (e.g. Gmail App Password: smtp.gmail.com / 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Amar Haat <your@gmail.com>"
# Secret used to HMAC-hash stored OTPs (set a long random string in production)
OTP_HASH_SECRET=
# If neither RESEND_API_KEY nor SMTP_HOST is set, OTPs are only logged to the server console (non-production).
